# --- Cloned third-party reference repos (do not redistribute) ---
cuda-course/
CUDALibrarySamples/
cuda-samples/
gaussian-splatting/
kernels/
pmpp/
taming-3dgs/

# Symlink pointing outside this folder (target lives in reference_code/)
GaussianFormer

# Vendored upstream repos (held locally for reference, not redistributed)
reference_code/

# nuScenes data + downloaders (heavy; user-managed)
data/
nuscenes/
BaiduPCS-Go-v4.0.1-linux-amd64/

# Kernel exploration / large diff blobs (vendored 3rd-party + scratch)
# Exception: kernel/localagg_s2go/ is the S2GO-authored CUDA kernel that
# Stage-2 imports at runtime — track it explicitly. See bottom of file for
# the build-artifact exclusions inside it.
kernel/*
!kernel/localagg_s2go/
scripts/kernel_diff/

# Claude Code session state
.claude/

# --- Build artifacts ---
**/build/
**/*.egg-info/
**/__pycache__/
**/*.so
**/*.o
**/*.pyc
**/*.pyd

# Exception: the S2GO CUDA kernel's compiled extension. Track this binary
# so cloning is sufficient on identical-GPU-arch machines (both PCs are
# RTX 3060, SM 8.6). On a machine with a different SM, run
# `pip install -e kernel/localagg_s2go/` to rebuild after cloning.
!kernel/localagg_s2go/local_aggregate_s2go/_C.cpython-*.so

# --- Trained model weights (heavy; reproducible from overfit.py --save-path) ---
out/
**/*.pt
**/*.pth
**/*.ckpt

# --- Paper PDFs (excluded for size + licensing; see arxiv links in docs) ---
*.pdf

# --- Editor / OS noise ---
*.swp
*~
.DS_Store
.idea/
.vscode/
